DB_HOST=localhost
DB_PORT=5432
DB_NAME=pathfinder_db
DB_USER=pathfinder_app
DB_PASSWORD=replace_with_your_local_password
# Hosted PostgreSQL: enable the mode required by the provider.
# DB_SSLMODE=require
# DB_SSLROOTCERT=/path/to/provider-ca.pem
# Neon connection security, when enabled for the hosted database:
# DB_CHANNEL_BINDING=require
JWT_SECRET_KEY=replace_with_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
QUESTIONNAIRE_ENRICH_PROFILE=false
